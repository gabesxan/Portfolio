# Portfolio-only local development; never reuse Bora values.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio-local-only
API_PORT=3001
# Generate with: openssl rand -hex 32 (server only; no VITE_ prefix)
ADMIN_SECRET=
# Optional real DB tests; must end in _test. Local compose provisions it.
TEST_DATABASE_URL=mysql://portfolio:portfolio-local-only@127.0.0.1:3307/portfolio_test
# Browser uses /api and development proxy by default. Never put secrets here.
VITE_API_BASE_URL=/api
